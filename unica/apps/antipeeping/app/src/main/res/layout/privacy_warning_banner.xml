<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginHorizontal="16dp"
    android:padding="14dp"
    android:background="@drawable/bg_warning_banner"
    android:elevation="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚠️"
        android:textSize="22sp"
        android:layout_marginEnd="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/peeping_alert_title"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/peeping_alert_desc"
            android:textColor="#E0E0E0"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_snooze_cowatch"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="@string/btn_snooze_text"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_snooze_btn"
        android:paddingHorizontal="10dp"
        android:minWidth="0dp" />

</LinearLayout>