<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#364E68" />
            <stroke android:width="1dp" android:color="#00E5FF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#243C56" />
            <stroke android:width="1.5dp" android:color="#00E676" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#1A2634" />
            <stroke android:width="1dp" android:color="#2C4054" />
        </shape>
    </item>
</selector>
