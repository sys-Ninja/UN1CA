<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:background="@drawable/bg_tool_pill">

    <ImageButton
        android:id="@+id/btn_ghost_toggle"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_camera"
        android:tint="#FFFFFF"
        android:contentDescription="Toggle Ghost" />

    <TextView
        android:id="@+id/btn_slot_1"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:text="1"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@android:color/transparent" />

    <TextView
        android:id="@+id/btn_slot_2"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="4dp"
        android:gravity="center"
        android:text="2"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@android:color/transparent" />

    <TextView
        android:id="@+id/btn_slot_3"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="4dp"
        android:gravity="center"
        android:text="3"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@android:color/transparent" />

    <ImageButton
        android:id="@+id/btn_next_media"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="6dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_media_next"
        android:tint="#FFFFFF"
        android:contentDescription="Next Slot" />

    <ImageButton
        android:id="@+id/btn_pick_media"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="4dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_gallery"
        android:tint="#FFFFFF"
        android:contentDescription="Pick Media" />

    <TextView
        android:id="@+id/lbl_slot_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="4dp"
        android:textSize="11sp"
        android:textColor="#CCFFFFFF"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
