<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:title="@string/unica_dynamicisland_settings_title" settings:hierarchicalParentFragment="io.mesalabs.unica.settings.UnicaSettingsFragment" settings:topLevelPreferenceKey="unica_dynamicisland_settings"
