    <SecSwitchPreference android:title="@string/unica_di_enabled_title" android:key="unica_di_enabled" android:summary="@string/unica_di_enabled_summary" settings:controller="io.mesalabs.unica.settings.dynamicisland.EnabledPreferenceController" />
    <com.samsung.android.settings.widget.SecInsetCategoryPreference />
    <SecSwitchPreference android:title="@string/unica_di_calls_title" android:key="unica_di_calls" android:summary="@string/unica_di_calls_summary" android:dependency="unica_di_enabled" settings:controller="io.mesalabs.unica.settings.dynamicisland.CallsToggleController" />
    <SecSwitchPreference android:title="@string/unica_di_music_title" android:key="unica_di_music" android:summary="@string/unica_di_music_summary" android:dependency="unica_di_enabled" settings:controller="io.mesalabs.unica.settings.dynamicisland.MusicToggleController" />
